# Copy to .env and fill in:  cp frontend/.env.example frontend/.env
# Saving .env restarts the frontend automatically.
# No secrets belong in this file — the client secret lives in backend/.env.

# true = the single-page configurator, false = the full demo app
IND_CONFIGURATOR=true

# Which folder of Informed Design products to configure. Required when
# IND_CONFIGURATOR=true. Find both in the demo app: user menu -> Show IDs.
# The "b." prefix on the project id is fine.
ACC_PROJECT_ID=
ACC_FOLDER_URN=

# Branding — placeholders, swap for your own.
# The logo is a file in frontend/public/, not a URL.
YOUR_BRAND_NAME=Your Company
YOUR_BRAND_TITLE=Product Configurator
YOUR_BRAND_LOGO=/logo-placeholder.svg
YOUR_BRAND_PRIMARY=#0696d7
YOUR_BRAND_ACCENT=#1a1a1a
YOUR_BRAND_BG=#f4f5f7

# Local dev defaults — leave alone unless your ports clash.
PORT=3000
BACKEND_URL=http://localhost:8080
REACT_APP_OUTPUT_TYPE=SVF
