{
  "name": "frontend-app",
  "version": "0.0.5",
  "private": true,
  "homepage": "./",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "postinstall": "patch-package"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:8080",
  "overrides": {
    "glob": "^10.0.0",
    "rimraf": "^5.0.0",
    "@babel/plugin-proposal-private-methods": "npm:@babel/plugin-transform-private-methods@^7.23.0",
    "@babel/plugin-proposal-numeric-separator": "npm:@babel/plugin-transform-numeric-separator@^7.23.0",
    "@babel/plugin-proposal-nullish-coalescing-operator": "npm:@babel/plugin-transform-nullish-coalescing-operator@^7.23.0",
    "@babel/plugin-proposal-class-properties": "npm:@babel/plugin-transform-class-properties@^7.23.0",
    "@babel/plugin-proposal-optional-chaining": "npm:@babel/plugin-transform-optional-chaining@^7.23.0",
    "@babel/plugin-proposal-private-property-in-object": "npm:@babel/plugin-transform-private-property-in-object@^7.23.0",
    "rollup-plugin-terser": "npm:@rollup/plugin-terser@^0.4.4",
    "@humanwhocodes/config-array": "npm:@eslint/config-array@^0.15.0",
    "@humanwhocodes/object-schema": "npm:@eslint/object-schema@^2.1.0",
    "sourcemap-codec": "npm:@jridgewell/sourcemap-codec@^1.4.15",
    "svgo": "^3.0.0",
    "source-map": "^0.7.4"
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  }
}
