# Copy to .env and fill in:  cp backend/.env.example backend/.env
#
# Your .env is the only file holding a real credential, and it is gitignored.
# Do not copy it to .env.bak / .env.old / .env.save to "keep a backup" — those
# names are not in the ignore list, and that is a classic way for a credential
# to end up committed. A pre-commit hook blocks it (scripts/check-secrets.js),
# but the habit is the actual fix.
#
# From https://aps.autodesk.com/myapps — and remember to add the app as an ACC
# custom integration, or every Informed Design call returns 401.

APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_REDIRECT_URI=http://localhost:3000
